---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Button from '../components/Button.astro';
import Copy from '../components/Copy.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import Media from '../components/Media.astro';
import { COLOUR_COUNT } from '../data/colours';
import { COUNTRY_COUNT, REGION_COUNT } from '../data/countries';
import { awaiting, draft } from '../lib/content';
import { mediaSlot } from '../lib/media';
import { loadReviewCopy } from '../lib/review';

const review = await loadReviewCopy();

const opening = review
  ? draft(review.about.opening, 'Founder / content lead')
  : awaiting('Origin story', 'Approve the 120-180 word introduction explaining why the initiative was created.');

const founderPortrait = mediaSlot('about-founder', '4/5', 'Approved founder portrait with alt text, focal point, photographer credit and reuse permission.');
const heroMedia = mediaSlot('about-hero', '21/9', 'Approved photograph of the fabric, a workshop or a public programme.');

/** Section spine from the copy deck. Headings only: no narrative is invented. */
const sections = [
  { id: 'origin', label: 'Origin', title: 'Why this initiative exists.', need: 'Approve the origin story: what prompted the initiative and when it began.' },
  { id: 'mission', label: 'Mission and vision', title: 'What it sets out to do.', need: 'Approve the mission statement and the vision for where the initiative is going.' },
  { id: 'model', label: 'How it works', title: 'How the initiative is made.', need: 'Approve the explanation of how countries, designers and institutions take part.' },
];
---
<Layout
  title="About"
  description="Why The Pan-African Fabric was created: its origin, mission, vision, founder and the model behind an international cultural initiative."
  path="/about"
  header="overlay"
  progress
>
  <PageHero
    eyebrow="About"
    title="The why<span>behind the fabric.</span>"
    size="tall"
    media={heroMedia}
    meta={[`${COLOUR_COUNT} colours`, `${COUNTRY_COUNT} countries`, `${REGION_COUNT} regions`]}
  >
    <Copy copy={opening} class="page-hero__intro lead" fallbackTitle="Origin story" emptyTone="ink" />
  </PageHero>

  {sections.map((section, index) => (
    <Section tone={index % 2 === 0 ? 'ivory' : 'surface'} id={section.id}>
      <SectionHead eyebrow={`${String(index + 1).padStart(2, '0')} — ${section.label}`} title={section.title}>
        <EmptyState
          title={`${section.label} copy is not approved yet.`}
          text="This section is designed and ready. Approved copy drops straight in without a layout change."
          note={import.meta.env.DEV ? section.need : undefined}
        />
      </SectionHead>
    </Section>
  ))}

  <Section tone="ink" id="founder">
    <div class="founder">
      <div class="founder__media" data-reveal="mask">
        <Media media={founderPortrait} placeholderTone="ink" />
      </div>
      <div class="founder__copy" data-reveal="rise">
        <p class="eyebrow"><span>04 — The founder</span></p>
        <h2 class="founder__title">The creator.</h2>
        <blockquote class="founder__quote">
          <p class="founder__quote-text">A founder quote sits here, in the founder's own approved words.</p>
          <footer class="founder__quote-note">No quotation has been supplied. Nothing is quoted until it is approved and attributed.</footer>
        </blockquote>
        <EmptyState
          title="Founder biography is not approved yet."
          text="The portrait, quote and biography positions are all reserved above and beside this note."
          tone="ink"
          note={import.meta.env.DEV ? 'Supply approved portrait with photographer credit, a 120-180 word biography and one attributable quote.' : undefined}
        />
      </div>
    </div>
  </Section>

  <Section tone="paper" id="milestones">
    <SectionHead eyebrow="05 — Milestones" title="A public journey, recorded honestly.">
      <p>
        Milestones appear here once each one is verified. Dates, titles and outcomes are never estimated or filled in
        from a planning document.
      </p>
    </SectionHead>
    <ol class="timeline">
      {[1, 2, 3].map((position) => (
        <li class="timeline__item">
          <span class="timeline__marker" aria-hidden="true"></span>
          <span class="timeline__slot">
            <span class="badge badge--awaiting">Awaiting content</span>
            <span class="timeline__label">Milestone {position} position</span>
          </span>
        </li>
      ))}
    </ol>
    <p class="caption" style="margin-top:24px">
      Three positions are shown to demonstrate the layout. The real number of milestones follows the approved list.
    </p>
  </Section>

  <Section tone="ivory" size="tight">
    <div class="cluster cluster--between">
      <h2 class="h-inline">See what the initiative made.</h2>
      <p class="actions">
        <Button href="/edition-one">Explore Edition One<span class="button__arrow" aria-hidden="true">&#8594;</span></Button>
        <Button href="/partner-with-us" variant="secondary">Partner With Us</Button>
      </p>
    </div>
  </Section>
</Layout>

<style>
  .founder { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 5vw, 80px); align-items: start; }
  .founder__title { font-size: clamp(2rem, 4.4vw, 3.5rem); line-height: 1; letter-spacing: -0.035em; margin: 0 0 var(--space-lg); }
  .founder__quote { margin: 0 0 var(--space-lg); padding-left: var(--space-md); border-left: 2px solid var(--gold); }
  .founder__quote-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.35;
    color: var(--on-ink-muted);
    margin: 0 0 var(--space-2xs);
  }
  .founder__quote-note { font-size: 0.75rem; line-height: 1.5; color: var(--on-ink-muted); }
  @media (max-width: 899px) {
    .founder { grid-template-columns: minmax(0, 1fr); }
    .founder__media { max-width: 360px; }
  }

  .timeline { display: grid; gap: 0; }
  .timeline__item { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: var(--space-md); padding-block: var(--space-md); border-top: 1px solid var(--border); align-items: start; }
  .timeline__marker { width: 12px; height: 12px; margin-top: 6px; border: 2px solid var(--accent); border-radius: 50%; }
  .timeline__slot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
  .timeline__label { font-family: var(--font-display); font-size: 1.125rem; color: var(--muted); }

  .h-inline { font-size: clamp(1.5rem, 3vw, 2.25rem); margin: 0; max-width: 18ch; }
</style>
