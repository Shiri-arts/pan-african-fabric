---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Button from '../components/Button.astro';
import Copy from '../components/Copy.astro';
import PageHero from '../components/PageHero.astro';
import ColourGrid from '../components/ColourGrid.astro';
import CountryCard from '../components/CountryCard.astro';
import EventPoster from '../components/EventPoster.astro';
import EmptyState from '../components/EmptyState.astro';
import StoryCard from '../components/StoryCard.astro';
import Media from '../components/Media.astro';
import { COLOUR_COUNT } from '../data/colours';
import { COUNTRY_COUNT, REGION_COUNT, countries, countryPath, regionName } from '../data/countries';
import { eventPath, eventStructuredData, inauguralShowcase } from '../data/events';
import { TAGLINE, fastFacts } from '../data/site';
import { stories } from '../data/stories';
import { awaiting, draft } from '../lib/content';
import { mediaSlot } from '../lib/media';
import { loadReviewCopy, reviewStories } from '../lib/review';

const review = await loadReviewCopy();
const homeStories = [...stories, ...(await reviewStories())].slice(0, 3);

const introduction = review
  ? draft(review.home.definition, 'Founder / content lead')
  : awaiting('Initiative introduction', 'Approve the short introduction that sits under the hero tagline.');

const editionHeading = review
  ? draft(review.home.editionHeading, 'Founder / content lead')
  : awaiting('Edition One heading');

const editionIntro = review
  ? draft(review.home.editionIntro, 'Founder / content lead')
  : awaiting('Edition One introduction');

const designerSlots = countries.map((country) => ({
  country,
  designer: review?.designerRoster.find((entry) => entry.country === country.slug),
}));

const heroMedia = mediaSlot('home-hero', '16/9', 'Approved hero photograph with separate desktop and mobile crops, focal point, alt text, credit and reuse permission.');
const partnerMedia = mediaSlot('home-partner', '4/5', 'Approved photograph from a public programme, workshop or exhibition.');
---
<Layout
  description="An international cultural initiative. Edition One carries a twelve-colour fabric across nine African countries, leading to the inaugural showcase in Washington, D.C."
  path="/"
  header="overlay"
  structuredData={eventStructuredData(inauguralShowcase)}
>
  <PageHero
    eyebrow="An international cultural initiative"
    title="The Pan-African<span>Fabric</span>"
    tagline={TAGLINE}
    size="full"
    media={heroMedia}
    meta={[`${COLOUR_COUNT} colours`, `${COUNTRY_COUNT} countries`, `${REGION_COUNT} regions`]}
    credit="Image position reserved. Caption and credit appear here once approved photography, alt text and reuse permission are supplied."
  >
    <Copy copy={introduction} class="page-hero__intro lead" fallbackTitle="Initiative introduction" emptyTone="ink" />
    <p class="actions">
      <Button href="/edition-one" size="large">
        Explore Edition One<span class="button__arrow" aria-hidden="true">&#8594;</span>
      </Button>
      <Button href={eventPath(inauguralShowcase.slug)} variant="secondary" size="large">
        The inaugural showcase<span class="button__arrow" aria-hidden="true">&#8594;</span>
      </Button>
    </p>
  </PageHero>

  <Section tone="paper" id="showcase">
    <div data-reveal="rise">
      <EventPoster event={inauguralShowcase} level={2} kicker="The inaugural showcase" />
    </div>
  </Section>

  <Section tone="ivory" id="edition-one">
    <SectionHead eyebrow="01 — Edition One" title="Twelve colours. One fabric.">
      <Copy copy={editionHeading} class="lead" fallbackTitle="Edition One heading" />
      <Copy copy={editionIntro} fallbackTitle="Edition One introduction" />
      <Button href="/edition-one" variant="text">
        Explore the edition<span class="button__arrow" aria-hidden="true">&#8594;</span>
      </Button>
    </SectionHead>
    <ColourGrid tall label="The twelve colours of Edition One" />
    <p class="caption" style="margin-top:24px;max-width:76ch">
      Colour values are representative samples from the source artwork, which carries gentle gradients rather than flat
      swatches. They are shown for on-screen review and are not print colour specifications. Cameroon, Ghana and South
      Africa each carry two colours.
    </p>
  </Section>

  <Section tone="surface" id="countries">
    <SectionHead eyebrow="02 — The countries" title={`${COUNTRY_COUNT} countries across ${REGION_COUNT} African regions.`}>
      <p>
        Each country page holds the fabric, its colours and the creative work made from it. Profiles open as approved
        material is supplied.
      </p>
      <Button href="/edition-one" variant="text">
        See all countries<span class="button__arrow" aria-hidden="true">&#8594;</span>
      </Button>
    </SectionHead>
    <ul class="card-grid">
      {countries.map((country, index) => (
        <li data-reveal="rise" style={`--reveal-delay:${Math.min(index, 6) * 50}ms`}>
          <CountryCard country={country} index={index} />
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="ink" id="designers">
    <SectionHead eyebrow="03 — Designers and garments" title="One fabric, interpreted nine ways.">
      <p>
        Every country works with the same fabric and arrives somewhere different. Designer profiles, creative statements
        and finished garments publish only once the designer has approved them.
      </p>
    </SectionHead>
    <ul class="card-grid card-grid--narrow">
      {designerSlots.map(({ country, designer }) => (
        <li>
          <div class="designer-slot">
            <p class="designer-slot__region">{regionName(country.region)}</p>
            <p class="designer-slot__country">{country.name}</p>
            {designer ? (
              <p class="designer-slot__name">
                {designer.designer}
                <span class="draft-copy__mark"><span class="visually-hidden">Status: </span>Working roster · not approved</span>
              </p>
            ) : (
              <p class="designer-slot__name designer-slot__name--empty">Designer to be announced</p>
            )}
            <a class="designer-slot__link" href={countryPath(country.slug)}>
              Country page<span aria-hidden="true">&#8594;</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
    <p class="caption" style="margin-top:32px;color:var(--on-ink-muted);max-width:70ch">
      No biography, creative statement, garment image or credit is published here. Those are content dependencies, not
      design gaps.
    </p>
  </Section>

  <Section tone="ivory" id="stories">
    <SectionHead eyebrow="04 — Stories" title="The living voice of the initiative.">
      <p>Behind the scenes, country and designer stories, partnerships, founder reflections, interviews and milestones.</p>
      <Button href="/stories" variant="text">
        Go to Stories<span class="button__arrow" aria-hidden="true">&#8594;</span>
      </Button>
    </SectionHead>
    {homeStories.length > 0 ? (
      <ul class="card-grid card-grid--wide">
        {homeStories.map((story) => <li><StoryCard story={story} /></li>)}
      </ul>
    ) : (
      <EmptyState
        title="No stories have been published yet."
        text="The editorial index and the article template are built and ready. The first approved story appears here as soon as it is supplied."
        layout="centred"
      />
    )}
  </Section>

  <Section tone="paper" id="partner">
    <div class="partner-block">
      <div class="partner-block__copy" data-reveal="rise">
        <p class="eyebrow"><span>05 — Partner with us</span></p>
        <h2 class="partner-block__title">Bring the fabric<br />to your city.</h2>
        <p class="lead">
          Museums, embassies, universities, sponsors, cultural organisations, designers and future hosts shape where this
          initiative goes next.
        </p>
        <p class="actions">
          <Button href="/partner-with-us" size="large">
            Partner With Us<span class="button__arrow" aria-hidden="true">&#8594;</span>
          </Button>
          <Button href="/press-contact" variant="text">Press and contact</Button>
        </p>
      </div>
      <div class="partner-block__media" data-reveal="mask">
        <Media media={partnerMedia} />
      </div>
    </div>
  </Section>

  <Section tone="surface" size="tight" label="Edition One at a glance">
    <ul class="fact-row">
      {fastFacts.map((fact) => (
        <li><span class="fact-row__value">{fact.value}</span><span class="fact-row__label">{fact.label}</span></li>
      ))}
    </ul>
  </Section>
</Layout>

<style>
  .designer-slot {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: var(--space-md);
    border: 1px solid var(--on-ink-rule);
  }
  .designer-slot__region { font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin: 0; }
  .designer-slot__country { font-family: var(--font-display); font-size: 1.375rem; line-height: 1.1; margin: 0; }
  .designer-slot__name { font-size: 0.875rem; line-height: 1.45; color: var(--on-ink-muted); margin: 0; }
  .designer-slot__name--empty { font-style: italic; }
  .designer-slot__link {
    margin-top: auto;
    padding-top: var(--space-sm);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--touch-min);
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--on-ink);
    text-decoration: none;
  }
  .designer-slot__link:hover { text-decoration: underline; text-underline-offset: 5px; }

  .partner-block { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 5vw, 80px); align-items: center; }
  .partner-block__title { font-size: clamp(2.25rem, 5.4vw, 4.5rem); line-height: 0.98; letter-spacing: -0.04em; margin: 0 0 var(--space-md); }
  .partner-block__copy .lead { max-width: 34ch; }
  @media (max-width: 899px) {
    .partner-block { grid-template-columns: minmax(0, 1fr); }
    .partner-block__media { max-width: 420px; }
  }

  .fact-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-md); }
  .fact-row li { display: flex; flex-direction: column; gap: 2px; padding-top: var(--space-sm); border-top: 2px solid var(--text); }
  .fact-row__value { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1; letter-spacing: -0.04em; }
  .fact-row__label { font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 639px) { .fact-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
