---
/**
 * Reusable event detail template. The confirmed inaugural showcase resolves here at
 * /events/inaugural-pan-african-fabric-fashion-showcase; every unknown slug returns
 * a real HTTP 404.
 *
 * In the review build only, `?preview=archive` renders the post-event archive state
 * so it can be checked before the date passes. The switch is removed from production.
 */
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import Button from '../../components/Button.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
import Media from '../../components/Media.astro';
import NotFound from '../../components/NotFound.astro';
import { eventPath, eventPhase, eventStructuredData, findEvent, posterDate } from '../../data/events';
import { COUNTRY_COUNT } from '../../data/countries';

export const prerender = false;

const event = findEvent(Astro.params.slug);
if (!event) Astro.response.status = 404;

const previewArchive = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'archive';
const phase = event ? (previewArchive ? 'archive' : eventPhase(event)) : 'upcoming';
const date = event ? posterDate(event) : undefined;
---
{!event || !date ? (
  <Layout title="Event not found" description="The requested event does not exist." path={Astro.url.pathname}>
    <NotFound path={Astro.url.pathname} />
  </Layout>
) : (
  <Layout
    title={event.title}
    description={`${event.title}. ${event.dateLabel}${event.timeLabel ? `, ${event.timeLabel}` : ''}. ${event.venue}, ${event.location}.`}
    path={eventPath(event.slug)}
    header="overlay"
    structuredData={eventStructuredData(event)}
  >
    <section class="event-hero on-ink">
      <div class="event-hero__ground" aria-hidden="true"></div>
      <div class="page-hero__scrim" aria-hidden="true"></div>
      <div class="container event-hero__inner">
        <Breadcrumbs trail={[{ href: '/events', label: 'Events' }]} current={event.title} />
        <div class="hero-enter">
          <p class="eyebrow">
            <span>{phase === 'archive' ? 'Past event' : phase === 'today' ? 'Happening today' : 'Upcoming event'}</span>
          </p>
          <h1 class="event-hero__title">{event.title}</h1>
          <p class="event-hero__when">
            <span class="event-hero__date">{event.dateLabel}</span>
            {event.timeLabel && <span class="event-hero__time">{event.timeLabel}</span>}
          </p>
          <p class="event-hero__where">{event.venue}<span aria-hidden="true"> · </span>{event.location}</p>
        </div>
      </div>
    </section>

    <Section tone="paper" id="details">
      <div class="event-detail">
        <div class="event-detail__poster">
          <p class="event-poster__kicker">{date.month} {date.year}</p>
          <p class="event-poster__day">{date.day}</p>
          <p class="event-poster__when"><b>{date.weekday}</b>{event.timeLabel && <span>{event.timeLabel}</span>}</p>
        </div>
        <dl class="event-poster__facts event-detail__facts">
          <div><dt>Event</dt><dd>{event.title}</dd></div>
          <div><dt>Date</dt><dd>{event.dateLabel}</dd></div>
          {event.timeLabel && <div><dt>Time</dt><dd>{event.timeLabel}</dd></div>}
          <div><dt>Venue</dt><dd>{event.venue}</dd></div>
          <div><dt>Location</dt><dd>{event.location}</dd></div>
        </dl>
      </div>
      <p class="caption" style="margin-top:24px;max-width:72ch">
        These are the details supplied for this event. Timezone, tickets, registration, an official link, programme
        participants and partner credits are not listed because they have not been confirmed.
      </p>
    </Section>

    <Section tone="ivory" size="tight" flush="bottom">
      <Media media={event.hero} />
    </Section>

    <Section tone="ivory" id="about">
      <SectionHead eyebrow="About the event" title="What takes place.">
        <EmptyState
          title="The event description is not approved yet."
          text="This is where the event is described. Programme, participants and partner credits are added only when each one is confirmed."
          note={import.meta.env.DEV ? 'Approve the event description. Do not add Community Day framing, partner or sponsorship status, participants, ticketing or endorsement without separate approval.' : undefined}
        />
      </SectionHead>
    </Section>

    {phase === 'archive' ? (
      <Section tone="ink" id="archive-state">
        <SectionHead eyebrow="After the event" title="This event has taken place.">
          <p>
            The listing stays available as a record of what was scheduled. Attendance, outcomes, press response and
            programme details are published only when they are supplied and verified.
          </p>
        </SectionHead>
        <EmptyState
          title="No post-event material has been supplied."
          text="Photography, coverage and a written account appear here once approved."
          tone="ink"
        />
      </Section>
    ) : (
      <Section tone="ink" id="attend">
        <SectionHead eyebrow="Attending" title="How to attend.">
          <p>
            Access details are published once confirmed by the venue. No ticketing, registration or booking route is
            offered here, because none has been confirmed.
          </p>
        </SectionHead>
        <EmptyState
          title="Attendance details are not confirmed yet."
          text="Timezone, entry arrangements and any official event link will appear here."
          tone="ink"
        />
      </Section>
    )}

    <Section tone="surface" id="edition">
      <SectionHead eyebrow="What is shown" title="Edition One.">
        <p>
          The event presents Edition One: one fabric, twelve colours and {COUNTRY_COUNT} countries.
        </p>
        <p class="actions">
          <Button href="/edition-one">Explore Edition One<span class="button__arrow" aria-hidden="true">&#8594;</span></Button>
          <Button href="/events" variant="text">All events</Button>
        </p>
      </SectionHead>
    </Section>
  </Layout>
)}

<style>
  .event-hero { position: relative; isolation: isolate; display: flex; align-items: flex-end; min-height: min(62svh, 640px); }
  .event-hero__ground {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 90% at 84% 10%, rgb(217 165 33 / 36%) 0%, transparent 60%),
      radial-gradient(110% 90% at 10% 96%, rgb(139 47 36 / 52%) 0%, transparent 62%),
      linear-gradient(168deg, #2b2723 0%, #1b1816 52%, #121010 100%);
  }
  .event-hero__inner { position: relative; padding-block: clamp(28px, 5vw, 72px); width: 100%; }
  .event-hero__title { font-size: clamp(2.25rem, 5.6vw, 4.5rem); line-height: 0.98; letter-spacing: -0.035em; margin: var(--space-sm) 0 var(--space-md); max-width: 18ch; }
  .event-hero__when { display: flex; flex-wrap: wrap; gap: var(--space-md); margin: 0 0 var(--space-2xs); font-size: clamp(1rem, 1.6vw, 1.25rem); }
  .event-hero__date { font-weight: 500; }
  .event-hero__time { color: var(--on-ink-muted); }
  .event-hero__where { font-size: 0.9375rem; color: var(--on-ink-muted); margin: 0; }

  .event-detail { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(20px, 3vw, 56px); align-items: start; }
  .event-detail__poster { display: flex; flex-direction: column; gap: var(--space-sm); padding: clamp(20px, 2.6vw, 40px); background: var(--ink-deep); color: #f7f3e8; }
  .event-detail__facts { align-self: center; }
  @media (max-width: 899px) { .event-detail { grid-template-columns: minmax(0, 1fr); } }
</style>
