---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import SectionHead from '../../components/SectionHead.astro';
import Copy from '../../components/Copy.astro';
import PageHero from '../../components/PageHero.astro';
import EventPoster from '../../components/EventPoster.astro';
import EventCard from '../../components/EventCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { eventStructuredData, groupEvents, inauguralShowcase } from '../../data/events';
import { awaiting, draft } from '../../lib/content';
import { mediaSlot } from '../../lib/media';
import { loadReviewCopy } from '../../lib/review';

const review = await loadReviewCopy();
const { featured, upcoming, archive } = groupEvents();

const intro = review
  ? draft(review.events.intro, 'Content lead')
  : awaiting('Events introduction', 'Approve the introduction to public programmes and presentations.');

const heroMedia = mediaSlot('events-hero', '21/9', 'Approved photograph from a public programme or exhibition.');

/** Formats the initiative presents. Layouts exist for each; none is populated with invented events. */
const formats = [
  { title: 'Exhibitions', text: 'Presentations of the fabric and the finished garments.' },
  { title: 'Workshops', text: 'Practical sessions with designers, students and communities.' },
  { title: 'Competitions', text: 'Open calls and design competitions.' },
  { title: 'Receptions', text: 'Openings and cultural receptions.' },
  { title: 'Talks', text: 'Conversations on textile, design and cultural exchange.' },
  { title: 'Travelling presentations', text: 'The edition presented in new cities and venues.' },
];
---
<Layout
  title="Events"
  description="Where The Pan-African Fabric happens: the inaugural showcase at the Smithsonian National Museum of African Art, and the exhibitions, workshops, competitions, receptions and talks that follow."
  path="/events"
  header="overlay"
  structuredData={eventStructuredData(inauguralShowcase)}
>
  <PageHero
    eyebrow="Events"
    title="Where it<span>happens.</span>"
    size="tall"
    media={heroMedia}
    meta={['Exhibitions', 'Workshops', 'Talks']}
  >
    <Copy copy={intro} class="page-hero__intro lead" fallbackTitle="Events introduction" emptyTone="ink" />
  </PageHero>

  {featured && (
    <Section tone="paper" id="featured">
      <div data-reveal="rise">
        <EventPoster event={featured} level={2} />
      </div>
    </Section>
  )}

  <Section tone="ivory" id="upcoming">
    <SectionHead eyebrow="Upcoming" title="What is coming next.">
      <p>Only confirmed events are listed. Nothing provisional is shown as if it were scheduled.</p>
    </SectionHead>
    {upcoming.length > 0 ? (
      <ul class="card-grid card-grid--wide">
        {upcoming.map((event) => <li><EventCard event={event} /></li>)}
      </ul>
    ) : (
      <EmptyState
        title="No further events are confirmed yet."
        text="The inaugural showcase is the confirmed event for Edition One. Additional dates appear here as each one is confirmed."
        layout="centred"
      />
    )}
  </Section>

  <Section tone="surface" id="formats">
    <SectionHead eyebrow="Formats" title="The shapes this initiative takes.">
      <p>Each format has a layout ready. A format appears in the listings above only when a real event is confirmed.</p>
    </SectionHead>
    <ul class="format-grid">
      {formats.map((format) => (
        <li class="format">
          <span class="format__title">{format.title}</span>
          <span class="format__text">{format.text}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="ink" id="archive">
    <SectionHead eyebrow="Archive" title="Past events.">
      <p>
        After an event has taken place, it moves here. The archive records what was scheduled; it never claims
        attendance, outcomes or press response that has not been supplied.
      </p>
    </SectionHead>
    {archive.length > 0 ? (
      <ul class="card-grid card-grid--wide">
        {archive.map((event) => <li><EventCard event={event} /></li>)}
      </ul>
    ) : (
      <EmptyState
        title="The archive is empty."
        text="No event in this edition has taken place yet."
        tone="ink"
        layout="centred"
      />
    )}
  </Section>
</Layout>

<style>
  .format-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 0 clamp(16px, 3vw, 48px); }
  .format { display: flex; flex-direction: column; gap: 4px; padding-block: var(--space-md); border-top: 1px solid var(--border); }
  .format__title { font-family: var(--font-display); font-size: 1.375rem; line-height: 1.15; }
  .format__text { font-size: 0.875rem; line-height: 1.5; color: var(--muted); }
</style>
