---
import { seedRecords, SOURCE_TRUTH_VERSION } from '../../scripts/cms/approved-content-seed.mjs';

if (import.meta.env.PUBLIC_CMS_REVIEW_MODE !== 'true') {
  return new Response('Not found', { status: 404 });
}

const groups = Object.entries(Object.groupBy(seedRecords, record => record.collectionId));
const textFromRichText = (value: any) => value?.nodes
  ?.flatMap((node: any) => node.nodes ?? [])
  .map((node: any) => node.textData?.text ?? '')
  .join('\n');
const displayValue = (value: any) => {
  if (value && typeof value === 'object' && Array.isArray(value.nodes)) return textFromRichText(value);
  if (Array.isArray(value)) return value.join(', ');
  if (value && typeof value === 'object') return JSON.stringify(value);
  return String(value);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>CMS seed review | The Pan-African Fabric</title>
  </head>
  <body>
    <header>
      <p class="eyebrow">Draft review only · not public content</p>
      <h1>CMS seed review</h1>
      <p>This preview shows the exact allowlisted seed manifest used for Wix CMS draft migration. It contains {seedRecords.length} records across {groups.length} collections.</p>
      <p class="version">Source version: <code>{SOURCE_TRUTH_VERSION}</code></p>
    </header>
    <main>
      {groups.map(([collection, records]) => (
        <section aria-labelledby={`collection-${collection}`}>
          <div class="section-heading">
            <h2 id={`collection-${collection}`}>{collection}</h2>
            <span>{records?.length ?? 0} records</span>
          </div>
          <div class="grid">
            {records?.map(record => (
              <article>
                {record.collectionId === 'MediaAssets' && record.data.image && (
                  <img src={record.data.image} alt={record.data.alt ?? ''} loading="lazy" />
                )}
                <div class="card-body">
                  <p class="status">Draft · {record.data.usagePermission ?? 'migration allowlist'}</p>
                  <h3>{record.data.title ?? record.id}</h3>
                  <p class="record-id"><code>{record.id}</code></p>
                  <dl>
                    {Object.entries(record.data).map(([key, value]) => (
                      <div><dt>{key}</dt><dd>{displayValue(value)}</dd></div>
                    ))}
                  </dl>
                  <details><summary>Source record</summary><p>{record.approvalSource}</p></details>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  :root { color-scheme: light; font-family: Arial, sans-serif; background: #f7f0e4; color: #171411; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header, main { width: min(92rem, calc(100% - 2rem)); margin-inline: auto; }
  header { padding: 4rem 0 2rem; border-bottom: 1px solid #bcae98; }
  h1, h2, h3 { font-family: Georgia, serif; }
  h1 { margin: .4rem 0 1rem; font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: .95; }
  h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3rem); }
  h3 { margin: .4rem 0; font-size: 1.4rem; }
  .eyebrow, .status { color: #a34325; font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .version { color: #594f44; }
  section { padding: 3rem 0; border-bottom: 1px solid #bcae98; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .section-heading span { color: #65594c; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
  article { overflow: hidden; border: 1px solid #cabba5; border-radius: .4rem; background: #fffaf2; }
  article img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: contain; background: white; border-bottom: 1px solid #cabba5; }
  .card-body { padding: 1.1rem; }
  .record-id { overflow-wrap: anywhere; color: #65594c; }
  dl { margin: 1rem 0; }
  dl div { display: grid; grid-template-columns: minmax(8rem, 1fr) 2fr; gap: 1rem; padding: .45rem 0; border-top: 1px solid #d9cbb8; }
  dt { font-weight: 700; }
  dl div { display: grid; grid-template-columns: minmax(7rem, .35fr) 1fr; gap: .75rem; padding: .5rem 0; border-top: 1px solid #e4d8c6; }
  dt { font-weight: 700; overflow-wrap: anywhere; }
  dd { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  details p { overflow-wrap: anywhere; }
  @media (max-width: 35rem) { dl div { grid-template-columns: 1fr; gap: .2rem; } }
</style>
