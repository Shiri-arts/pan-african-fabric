---
/**
 * Route metadata.
 *
 * Review builds are `noindex, nofollow`. No canonical URL and no social image are
 * emitted, because no production frontend URL and no approved social artwork
 * exist. The contracts are in place for both: `resolveMeta` produces a canonical
 * as soon as an origin is approved.
 */
import { resolveMeta, type PageMeta } from '../lib/seo';
import { safeRobots } from '../lib/cms-presentation';
interface Props extends PageMeta {
  siteName?: string;
  canonicalOrigin?: string;
  cmsRobots?: string;
  titlePattern?: string;
  socialImageUrl?: string;
  socialImageAlt?: string;
}
const { siteName, canonicalOrigin, cmsRobots, titlePattern, socialImageUrl, socialImageAlt, ...pageMeta } = Astro.props;
const fallback = resolveMeta(pageMeta);
const canonical = canonicalOrigin ? new URL(pageMeta.path, canonicalOrigin).toString() : fallback.canonical;
const resolvedSiteName = siteName ?? fallback.siteName;
const defaultTitle = pageMeta.title ? `${pageMeta.title} | ${resolvedSiteName}` : resolvedSiteName;
const patternedTitle = pageMeta.title && titlePattern && /\{(?:title|pageTitle)\}/.test(titlePattern)
  ? titlePattern.replaceAll('{pageTitle}', pageMeta.title).replaceAll('{title}', pageMeta.title).replaceAll('{siteName}', resolvedSiteName).slice(0, 300)
  : undefined;
const meta = {
  ...fallback,
  siteName: resolvedSiteName,
  documentTitle: patternedTitle ?? defaultTitle,
  canonical,
  robots: safeRobots(cmsRobots, fallback.robots),
};
const structuredData = meta.structuredData ? JSON.stringify(meta.structuredData).replaceAll('<', '\\u003c') : undefined;
---
<title>{meta.documentTitle}</title>
<meta name="description" content={meta.description} />
<meta name="robots" content={meta.robots} />
{meta.canonical && <link rel="canonical" href={meta.canonical} />}
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:type" content={meta.ogType} />
<meta property="og:title" content={meta.documentTitle} />
<meta property="og:description" content={meta.description} />
{meta.canonical && <meta property="og:url" content={meta.canonical} />}
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
<meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={meta.documentTitle} />
<meta name="twitter:description" content={meta.description} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
{socialImageUrl && socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
{structuredData && (
  <script type="application/ld+json" is:inline set:html={structuredData} />
)}
