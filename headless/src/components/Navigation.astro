---
import Container from './Container.astro';
import { navigation } from '../data/navigation';
import MenuToggle from './MenuToggle';
interface Props { tagline?: string; }
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <Container class="header-row">
    <a class="brand" href="/" aria-label="The Pan-African Fabric — home">
      <span class="brand-name">The Pan-African<br />Fabric</span>
      {Astro.props.tagline && <span class="brand-tagline">{Astro.props.tagline}</span>}
    </a>
    <MenuToggle client:load />
    <nav id="primary-navigation" class="primary-navigation" aria-label="Main navigation">
      <ul>{navigation.map(({ href, label }) => <li><a href={href} aria-current={current === href || current.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a></li>)}</ul>
      <a class="press-action" href="/media#press-kit">Press Kit</a>
    </nav>
  </Container>
</header>
