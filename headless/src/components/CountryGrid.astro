---
/**
 * The nine-country grid.
 *
 * This is the country index: every country appears exactly once, so no separate
 * list is needed beneath it. Colour is the ground rather than the subject, and
 * country, region and status are all text.
 */
import CountryTile from './CountryTile.astro';
import { countries, type Country } from '../data/countries';

interface CountryEntry {
  readonly country: Country;
  readonly regionLabel?: string;
  readonly colours?: readonly { readonly hex: string; readonly textOn: string }[];
  readonly status?: string;
}
interface Props { label?: string; class?: string; entries?: readonly CountryEntry[]; }
const { label = 'Edition One countries', class: className, entries: suppliedEntries } = Astro.props;
const entries = suppliedEntries ?? (import.meta.env.DEV ? countries.map(country => ({ country })) : []);
---
<ul class:list={['tile-grid', className]} aria-label={label}>
  {entries.map((entry, index) => (
    <li data-reveal="rise" style={`--reveal-delay:${Math.min(index, 8) * 45}ms`}>
      <CountryTile {...entry} index={index} />
    </li>
  ))}
</ul>
