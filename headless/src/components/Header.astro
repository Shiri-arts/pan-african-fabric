---
/**
 * Global header.
 *
 * Over a dark hero it starts quiet and transparent, then becomes a solid,
 * accessible bar as soon as the page scrolls past the hero. The scroll state is
 * driven by an IntersectionObserver on a sentinel rather than a scroll listener,
 * and its absence degrades to the solid header.
 *
 * Each menu item previews its page's real sections. The panel opens on hover and
 * on keyboard focus, both in CSS, so it works without JavaScript and is never
 * pointer-only. Escape closes it, which satisfies the dismissible requirement for
 * content shown on hover or focus. Below 1100px the panel is part of the existing
 * accordion instead, because touch has no hover.
 */
import Container from './Container.astro';
import MenuToggle from './MenuToggle';
import { isCurrent, navigation, primaryAction } from '../data/navigation';
import type { CmsNavigationItem } from '../lib/wix-cms';
import { mergeNavigation } from '../lib/cms-presentation';
interface Props { mode?: 'solid' | 'overlay'; siteName?: string; cmsNavigation?: readonly CmsNavigationItem[]; cmsNavigationConfigured?: boolean; }
const { mode = 'solid', siteName = 'The Pan-African Fabric', cmsNavigation = [], cmsNavigationConfigured = false } = Astro.props;
const path = Astro.url.pathname;
const primaryCms = cmsNavigation.filter(item => !item.highlighted);
const actionCms = cmsNavigation.find(item => item.highlighted);
const resolvedNavigation = cmsNavigationConfigured ? mergeNavigation(primaryCms, navigation, false) : navigation;
const resolvedAction = actionCms && actionCms.href === primaryAction.href
  ? { ...primaryAction, label: actionCms.label }
  : cmsNavigationConfigured ? undefined : primaryAction;
---
<span id="header-sentinel" aria-hidden="true" style={`--sentinel-height:${mode === 'overlay' ? 'min(58vh, 560px)' : '16px'}`}></span>
<header class="site-header" data-mode={mode} data-stuck="false">
  <Container class="header-row">
    <a class="brand" href="/" aria-label={`${siteName}, home`}>
      <span class="brand__name">{siteName}</span>
    </a>
    <MenuToggle client:load />
    <nav id="primary-navigation" class="header-nav" aria-label="Main">
      <ul class="header-nav__list">
        {resolvedNavigation.map((item) => (
          <li class="header-nav__item">
            <a
              class="header-nav__link"
              href={item.href}
              aria-current={isCurrent(item.href, path) ? 'page' : undefined}
            >
              {item.label}
              <span class="header-purpose" aria-hidden="true">{item.purpose}</span>
            </a>
            {item.sections && (
              <div class="submenu">
                <p class="submenu__purpose">{item.purpose}</p>
                <ul>
                  {item.sections.map((section) => (
                    <li><a class="submenu__link" href={section.href}>{section.label}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
      {resolvedAction && (
        <a
          class="header-action"
          href={resolvedAction.href}
          aria-current={isCurrent(resolvedAction.href, path) ? 'page' : undefined}
        >{resolvedAction.label}</a>
      )}
    </nav>
  </Container>
</header>
{/*
  Marks the enhancement before the page paints, rather than waiting for the menu
  island to hydrate. Below 1100px the navigation is in normal flow and therefore
  open, so collapsing it at hydration moved everything below the header up by
  around 1700px: enough to strand a deep link like /edition-one/cameroon#designer
  a screen and a half from its target, because a smooth scroll was already running
  toward the pre-collapse offset.

  It runs inline and un-deferred, immediately after the header markup, so the
  class and the visible toggle are in place for the first paint. Both depend on
  scripting, which is exactly what the class asserts: with no JavaScript neither
  happens and the navigation stays open with no toggle, as before.
*/}
<script is:inline>
  document.documentElement.classList.add('menu-enhanced');
  var menuToggle = document.getElementById('menu-toggle');
  var menuNav = document.getElementById('primary-navigation');
  if (menuToggle && menuNav) {
    menuToggle.removeAttribute('hidden');
    /*
      Collapsing the menu here means the button must work here too, even if the
      island never arrives. It stands down as soon as the island mounts and marks
      the document hydrated, so the two never both handle a tap.
    */
    menuToggle.addEventListener('click', function () {
      if (document.documentElement.classList.contains('menu-hydrated')) return;
      menuToggle.setAttribute('aria-expanded', String(menuNav.classList.toggle('is-open')));
    });
  }
</script>
<style>
  /*
    Depth marker for the header's scroll state. Absolutely positioned so it never
    affects layout; its height is how far the page must scroll before a quiet
    overlay header becomes solid.
  */
  #header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: var(--sentinel-height, 16px);
    pointer-events: none;
  }
</style>
<script>
  // Escape must dismiss an open section panel without moving the page.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.activeElement?.closest<HTMLElement>('.header-nav__item');
    if (!open) return;
    open.classList.add('is-dismissed');
    (open.querySelector<HTMLElement>('.header-nav__link'))?.focus();
    const clear = () => open.classList.remove('is-dismissed');
    open.addEventListener('pointerleave', clear, { once: true });
    open.addEventListener('focusout', clear, { once: true });
  });

  const header = document.querySelector<HTMLElement>('.site-header');
  const sentinel = document.getElementById('header-sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => header.setAttribute('data-stuck', entry && entry.isIntersecting ? 'false' : 'true'),
      { rootMargin: '0px' },
    ).observe(sentinel);
  }
</script>
