---
/**
 * A country tile.
 *
 * The tile carries the country's flag on a plain ground. The flag is what
 * identifies the country: several of these nine share a palette, and only the
 * star, emblem or disc separates them, so the whole flag is shown rather than a
 * colour taken from it.
 *
 * The ground is plain rather than an Edition One colour, so the number, region
 * and name sit on a known background and no text ever crosses a flag. Review
 * status is not published here. A country outside the flag set keeps the plain
 * tile and loses nothing but the image.
 */
import CountryFlag from './CountryFlag.astro';
import { countryPath, regionName, type Country } from '../data/countries';

interface Props {
  country: Country;
  index: number;
  regionLabel?: string;
  /** Approved flag image URL, when one is supplied through the media library. */
  flag?: string;
}
const { country, index, regionLabel, flag } = Astro.props;
---
<a class="tile" href={countryPath(country.slug)}>
  <CountryFlag name={country.name} slug={country.slug} override={flag} class="tile__flag" />
  <span class="tile__text">
    <span class="tile__top">
      <span class="tile__index">{String(index + 1).padStart(2, '0')}</span>
      <span class="tile__region">{regionLabel ?? regionName(country.region)}</span>
    </span>
    <span class="tile__name">{country.name}</span>
    <span class="tile__foot">
      <span class="tile__go">View country<span aria-hidden="true">&#8594;</span></span>
    </span>
  </span>
</a>
