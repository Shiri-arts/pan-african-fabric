---
/**
 * A country's flag, whole.
 *
 * The flag is neither cropped nor stretched: national flags have defined
 * proportions, and it is the emblem in the middle or the stripe at one edge that
 * tells two similar flags apart. The box is reserved at that flag's own ratio, so
 * the flag sits flush with no band around it and the card does not shift as the
 * file loads.
 *
 * Decorative: every card names its country in text beside the flag, so reading
 * "Flag of Ghana" aloud after the word "Ghana" would only repeat it.
 */
import { flagRatio, flagSource } from '../data/flags';
interface Props {
  /** Country name as published, preferred over the slug for resolution. */
  name?: string;
  slug?: string;
  /** Approved image URL, when a flag is supplied through the media library. */
  override?: string;
  class?: string;
}
const { name, slug, override, class: className } = Astro.props;
const source = flagSource(name, slug, override);
// An overriding image has no known ratio, so 3:2 reserves the common flag shape.
const ratio = flagRatio(name, slug) ?? 1.5;
---
{source && (
  <span class:list={['flag', className]} style={`--flag-ratio:${ratio}`}>
    <img src={source} alt="" loading="lazy" decoding="async" draggable="false" />
  </span>
)}
