---
/**
 * A country's flag, whole.
 *
 * The flag is contained rather than cropped or stretched: national flags have
 * defined proportions, and it is the emblem in the middle or the stripe at one
 * edge that tells two similar flags apart. The frame reserves a fixed 3:2 box so
 * the card does not shift as the file loads, and a flag of any other ratio sits
 * centred inside it.
 *
 * Decorative: every card names its country in text beside the flag, so reading
 * "Flag of Ghana" aloud after the word "Ghana" would only repeat it.
 */
import { flagSource } from '../data/flags';
interface Props {
  /** Country name as published, preferred over the slug for resolution. */
  name?: string;
  slug?: string;
  /** Approved image URL, when a flag is supplied through the media library. */
  override?: string;
  class?: string;
}
const { name, slug, override, class: className } = Astro.props;
const source = flagSource(name, slug, override);
---
{source && (
  <span class:list={['flag', className]}>
    <img src={source} alt="" loading="lazy" decoding="async" draggable="false" />
  </span>
)}
