---
import { colourStyle, type EditionColour } from '../data/colours';
import { countryPath, findCountry, regionName } from '../data/countries';
interface Props { colour: EditionColour; }
const { colour } = Astro.props;
const country = findCountry(colour.country)!;
---
<a class="colour-panel" href={countryPath(country.slug)} style={colourStyle(colour)}>
  <span class="colour-panel__field">
    <span class="colour-panel__index">{String(colour.index).padStart(2, '0')}</span>
    <span class="colour-panel__display">{colour.name}</span>
  </span>
  <span class="colour-panel__meta">
    <span class="colour-panel__country">{country.name}</span>
    <span class="colour-panel__region">{regionName(country.region)}</span>
    <span class="colour-panel__go">View country<span aria-hidden="true">&#8594;</span></span>
  </span>
</a>
