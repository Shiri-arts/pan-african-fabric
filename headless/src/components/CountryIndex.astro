---
/**
 * Compact nine-country index.
 *
 * Sits directly beneath the twelve-colour grid so the homepage carries the
 * countries once rather than three times. Each row states its region and its
 * approved-content availability as text; the colour rail repeats the country's
 * Edition One colours but never carries information on its own.
 */
import { colourStyle, coloursForCountry } from '../data/colours';
import { countries, countryPath, regionName } from '../data/countries';

interface Props { label?: string; class?: string; }
const { label = 'Edition One countries', class: className } = Astro.props;
---
<ul class:list={['country-index', className]} aria-label={label}>
  {countries.map((country, index) => (
    <li>
      <a class="country-index__link" href={countryPath(country.slug)}>
        <span class="country-index__rail" aria-hidden="true">
          {coloursForCountry(country.slug).map((colour) => (
            <span style={colourStyle(colour)}></span>
          ))}
        </span>
        <span class="country-index__no">{String(index + 1).padStart(2, '0')}</span>
        <span class="country-index__name">{country.name}</span>
        <span class="country-index__region">{regionName(country.region)}</span>
        <span class="country-index__state">
          {country.hasApprovedProfile ? 'Available' : 'In review'}
        </span>
        <span class="country-index__go" aria-hidden="true">&#8594;</span>
      </a>
    </li>
  ))}
</ul>
