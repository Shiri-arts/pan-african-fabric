---
import Eyebrow from './Eyebrow.astro';
interface Props {
  eyebrow?: string;
  title: string;
  /** Heading level. Pages keep exactly one h1; sections normally use h2. */
  level?: 2 | 3;
  id?: string;
  wide?: boolean;
  stack?: boolean;
  class?: string;
}
const { eyebrow, title, level = 2, id, wide = false, stack = false, class: className } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---
<div class:list={['section-head', wide && 'section-head--wide', stack && 'section-head--stack', className]}>
  <div>
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <Heading id={id} class="section-head__title">{title}</Heading>
  </div>
  <div class="section-head__aside"><slot /></div>
</div>
